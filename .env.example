# Supabase (https://supabase.com/dashboard → Project Settings → API / Database)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# App URL for approval links (Vercel sets VERCEL_URL automatically)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: override MapLibre style (default: OpenFreeMap Liberty — road names, shields, OSM POIs)
# NEXT_PUBLIC_MAPLIBRE_STYLE=https://tiles.openfreemap.org/styles/liberty

# Roboflow serverless detection (Deploy → curl snippet → model path + api_key)
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=canadian-goose/1
ROBOFLOW_API_BASE_URL=https://serverless.roboflow.com
ROBOFLOW_CONFIDENCE_THRESHOLD=0.5
# Comma-separated class names to count (case-insensitive)
ROBOFLOW_GOOSE_CLASSES=goose,Canada goose,canadian goose,bird

# Gemini — behaviour / summary only (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Email approval (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=Western Wingman <onboarding@resend.dev>
APPROVER_EMAIL=you@example.com

# HMAC secret for approval tokens (generate: openssl rand -hex 32)
APPROVAL_TOKEN_SECRET=
